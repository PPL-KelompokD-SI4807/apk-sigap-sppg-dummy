<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <!-- Kunci khusus tes (acak, bukan rahasia; JANGAN dipakai di lingkungan lain). -->
        <env name="APP_KEY" value="base64:c2lnYXAtc3BwZy10ZXN0LWtleS1ub3Qtc2VjcmV0ISE="/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="SANCTUM_EXPIRATION" value="480"/>
        <!-- Token bot palsu khusus tes (format mirip asli, tidak valid di Telegram). -->
        <env name="TELEGRAM_BOT_TOKEN" value="123456789:TEST-ONLY-NOT-A-REAL-BOT-TOKEN-sigap"/>
        <env name="TELEGRAM_BOT_USERNAME" value="sigap_test_bot"/>
        <env name="TELEGRAM_WEBHOOK_SECRET" value="test-webhook-secret"/>
        <env name="TELEGRAM_INIT_DATA_MAX_AGE" value="3600"/>
        <env name="TELEGRAM_DEV_BYPASS" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Agen AI/LLM/STT: netral agar tes tidak bergantung .env lokal (tes yang butuh penyedia mengatur config sendiri). -->
        <env name="LLM_PROVIDER" value="" force="true"/>
        <env name="LLM_BASE_URL" value="" force="true"/>
        <env name="LLM_API_KEY" value="" force="true"/>
        <env name="LLM_MODEL" value="" force="true"/>
        <env name="LLM_VISION_MODEL" value="" force="true"/>
        <env name="LLM_MAX_TOKENS" value="1024" force="true"/>
        <env name="LLM_TIMEOUT" value="20" force="true"/>
        <env name="STT_DRIVER" value="" force="true"/>
        <env name="STT_URL" value="" force="true"/>
        <env name="STT_API_KEY" value="" force="true"/>
        <env name="STT_MODEL" value="whisper-1" force="true"/>
        <env name="STT_TIMEOUT" value="20" force="true"/>
        <env name="AI_MAX_ITERATIONS" value="4" force="true"/>
        <env name="AI_RATE_PER_MINUTE" value="20" force="true"/>
        <env name="AI_RATE_PER_HOUR" value="30" force="true"/>
        <env name="AI_TOKEN_PER_MINUTE" value="0" force="true"/>
        <env name="AI_TOKEN_PER_DAY" value="0" force="true"/>
        <env name="AI_TOOL_SELECTION" value="auto" force="true"/>
        <env name="AI_TOOL_TOKEN_THRESHOLD" value="2500" force="true"/>
        <env name="AI_TOOL_MAX" value="10" force="true"/>
        <env name="AI_TOOL_MAX_TOKENS" value="2500" force="true"/>
        <env name="AI_DRAFT_TTL_MINUTES" value="30" force="true"/>
        <env name="AI_DRAFT_MAX_PENDING" value="10" force="true"/>
    </php>
</phpunit>
