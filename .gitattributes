* text=auto eol=lf

# Berkas yang dijalankan/dibaca di Linux (server, kontainer) wajib LF walau di-checkout di Windows.
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
docker/** text eol=lf
scripts/** text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.cnf text eol=lf
*.service text eol=lf
*.timer text eol=lf
docs/ops/env.production.example text eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
