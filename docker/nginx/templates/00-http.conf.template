# SiGAP SPPG - konteks http nginx (dirender ke /etc/nginx/conf.d/00-sigap-http.conf).
# Variabel templat (envsubst terbatas): ${TELEGRAM_WEBHOOK_IP_FILTER}. Variabel nginx ($remote_addr, ...) tidak disentuh.

server_tokens off;
charset utf-8;

# Format log tanpa query string (hindari data pribadi/token di log akses).
log_format sigap '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent $request_time "$http_user_agent"';

# Timeout & batas klien (mitigasi slowloris). 6m = unggahan 5 MiB + overhead multipart.
client_body_timeout 15s;
client_header_timeout 15s;
keepalive_timeout 30s;
send_timeout 30s;
client_max_body_size 6m;
client_body_buffer_size 128k;
large_client_header_buffers 4 16k;
reset_timedout_connection on;

# DNS internal Docker: nama `app` diselesaikan per permintaan (IP kontainer berubah saat deploy).
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;
map $host $sigap_php {
    default app:9000;
}

# Kompresi (respons /api/v1/auth* dikecualikan di lokasinya).
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/javascript application/javascript application/json
           application/manifest+json image/svg+xml;

# IP klien: nginx adalah tepi langsung (port 80/443 dipublikasikan lewat DNAT Docker, IPv4 saja), jadi
# $remote_addr sudah IP asli dan diteruskan sebagai REMOTE_ADDR ke Laravel (throttle per IP).
# Bila kelak ada CDN/ALB di depan: aktifkan set_real_ip_from <CIDR proxy>; real_ip_header X-Forwarded-For;
# real_ip_recursive on; DAN konfigurasi trustProxies Laravel. Jangan memercayai X-Forwarded-For tanpa itu.

# Rate limit dasar per IP (lapisan kasar di depan throttle Laravel). Zona kecil (1 MB ~ 16 ribu IP) agar muat
# dalam batas memori kontainer nginx (MEM_NGINX 48m); entri tertua dibuang otomatis saat zona penuh.
limit_req_zone $binary_remote_addr zone=sigap_api:2m rate=10r/s;
limit_req_zone $binary_remote_addr zone=sigap_auth:1m rate=30r/m;
limit_req_zone $binary_remote_addr zone=sigap_tg:1m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=sigap_conn:1m;
limit_req_status 429;
limit_conn_status 429;
limit_req_log_level warn;

# Webhook Telegram hanya dari CIDR resmi Telegram (https://core.telegram.org/bots/webhooks), selain
# header secret token yang diverifikasi Laravel. TELEGRAM_WEBHOOK_IP_FILTER=off mematikan saringan ini.
geo $sigap_tg_cidr {
    default 0;
    149.154.160.0/20 1;
    91.108.4.0/22 1;
}
map "${TELEGRAM_WEBHOOK_IP_FILTER}:$sigap_tg_cidr" $sigap_tg_tolak {
    default 0;
    "on:0" 1;
}

# HSTS hanya dikirim pada HTTPS (nilai kosong = header tidak dikirim).
map $scheme $sigap_hsts {
    https "max-age=15552000";
    default "";
}

# Health check kontainer (hanya loopback di dalam kontainer, tidak dipublikasikan).
server {
    listen 127.0.0.1:8080;
    access_log off;
    location = /nginx-health {
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        return 404;
    }
}
