server {
    listen 443 ssl;
    http2 on;
    server_name ${MINIAPP_DOMAIN};
    keepalive_timeout 30s;

    ssl_certificate     /etc/letsencrypt/live/${MINIAPP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MINIAPP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/sigap-tls.conf;

    access_log /var/log/nginx/access.log sigap;
    limit_conn sigap_conn 40;

    include /etc/nginx/snippets/sigap-app.conf;
    include /etc/nginx/snippets/sigap-miniapp.conf;

    location ^~ /api/v1/web/ {
        include /etc/nginx/snippets/headers-api.conf;
        return 404;
    }

    location ^~ /api/v1/telegram/ {
        include /etc/nginx/snippets/headers-api.conf;
        return 404;
    }

    location / {
        include /etc/nginx/snippets/headers-web.conf;
        return 404;
    }
}
