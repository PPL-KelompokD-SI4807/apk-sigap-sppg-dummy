# SiGAP SPPG - contoh .env PRODUKSI/STAGING untuk docker-compose.prod.yml. HANYA PLACEHOLDER.
# (Seharusnya bernama .env.production.example di akar repo; dipindah ke sini karena aturan izin agen.)
# Di server:  cp docs/ops/env.production.example .env && chmod 600 .env  lalu isi nilai nyata DI SERVER saja.
# Jangan pernah meng-commit .env. Nama variabel diambil dari config/*.php.
#
# Aturan nilai (dibaca Docker Compose env_file DAN scripts/*.sh):
#   - satu KUNCI=nilai per baris, tanpa `export`, tanpa spasi di sekitar `=`;
#   - jangan memakai karakter $ ` # \ atau kutip di dalam rahasia (bangkitkan dengan hex);
#   - nilai berspasi boleh diapit kutip ganda (mis. APP_NAME).
# Membangkitkan rahasia acak:  openssl rand -hex 32
# Sandi root MySQL TIDAK di sini, melainkan di .env.mysql (lihat docs/ops/env.mysql.example), agar tidak
# terlihat oleh kontainer aplikasi.

# Perintah `docker compose` manual dari direktori repo memakai berkas produksi secara otomatis.
COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_PROJECT_NAME=sigap

# ---------------------------------------------------------------------------
# Domain, TLS, image, sumber daya (dipakai docker-compose.prod.yml dan scripts/)
# ---------------------------------------------------------------------------
# Nama host publik tanpa skema. Staging tanpa domain: <ip-dengan-tanda-strip>.sslip.io (lihat runbook).
DOMAIN=sigap.example.id
# Email pemberitahuan Let's Encrypt (scripts/bootstrap-cert.sh).
CERTBOT_EMAIL=admin@example.id
# Mode image scripts/deploy.sh: local (build di server, cadangan) | registry (tarik image berlabel).
DEPLOY_IMAGE_MODE=local
# Prefiks image. local: biarkan `localhost`. registry: mis. ghcr.io/<organisasi> (image <prefiks>/sigap-sppg-app).
IMAGE_REGISTRY=localhost
# IMAGE_TAG TIDAK diisi di sini: ditulis scripts/deploy.sh ke .deploy/image.env (tag git atau sha 12 karakter).
# Saringan CIDR Telegram untuk webhook di nginx (on|off).
TELEGRAM_WEBHOOK_IP_FILTER=on
# Plafon memori kontainer (VPS 2 GiB). Naikkan saat uji beban tanpa mengubah berkas compose.
# MEMSWAP_* = memori + swap dan WAJIB >= MEM_* yang sesuai (naikkan bersamaan). MySQL tanpa swap (= MEM_MYSQL).
MEM_MYSQL=640m
MEM_APP=448m
MEMSWAP_APP=704m
MEM_QUEUE=192m
MEMSWAP_QUEUE=448m
MEM_SCHEDULER=160m
MEMSWAP_SCHEDULER=416m
MEM_NGINX=48m
MEMSWAP_NGINX=304m
PHP_FPM_MAX_CHILDREN=4
# Ruang disk bebas minimum (GB) yang diperiksa preflight deploy.
DEPLOY_MIN_FREE_GB=5
# true saat go-live: deploy MENOLAK berjalan bila BACKUP_REMOTE/BACKUP_AGE_RECIPIENT kosong.
DEPLOY_GO_LIVE=false
# Versi image MySQL (mengubahnya = perubahan definisi mysql; deploy butuh --allow-db-change).
MYSQL_VERSION=8.4
# Batas memori sandbox MySQL sesaat untuk restore.sh / restore-test.sh.
RESTORE_SANDBOX_MEM=512m

# ---------------------------------------------------------------------------
# Aplikasi (config/app.php, config/logging.php)
# ---------------------------------------------------------------------------
APP_NAME="SiGAP SPPG"
# Wajib production dan false; scripts/deploy.sh menolak nilai lain, compose juga memaksanya.
APP_ENV=production
APP_DEBUG=false
# Bangkitkan sekali:  docker compose -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
# Simpan juga di pengelola kata sandi (tidak ikut dicadangkan). Mengganti APP_KEY membatalkan data terenkripsi.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_URL=https://sigap.example.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Database (MySQL 8.4 di kontainer `mysql`; DB_HOST/DB_PORT dipaksa compose)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sigap_sppg
DB_USERNAME=sigap
# openssl rand -hex 32
DB_PASSWORD=GANTI_DENGAN_HASIL_openssl_rand_hex_32
# Sandi root MySQL: di .env.mysql (MYSQL_ROOT_PASSWORD), BUKAN di sini.

# ---------------------------------------------------------------------------
# Sesi, cache, antrean (driver database, tanpa Redis; config/session.php, cache.php, queue.php)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
# Harus lebih besar dari --timeout worker (80 s, docker-compose.prod.yml).
DB_QUEUE_RETRY_AFTER=120
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Telegram (config/telegram.php)
# ---------------------------------------------------------------------------
# Dari @BotFather. RAHASIA.
TELEGRAM_BOT_TOKEN=GANTI_DENGAN_TOKEN_BOTFATHER
TELEGRAM_BOT_USERNAME=nama_bot_tanpa_at
# Secret header webhook: 16-256 karakter [A-Za-z0-9_-]. Bangkitkan:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=GANTI_DENGAN_HASIL_openssl_rand_hex_32
TELEGRAM_MINIAPP_URL=https://sigap.example.id/miniapp/
# WAJIB false di produksi/staging (deploy menolak true).
TELEGRAM_DEV_BYPASS=false
TELEGRAM_INIT_DATA_MAX_AGE=3600
TELEGRAM_HTTP_TIMEOUT=10

# ---------------------------------------------------------------------------
# Agen AI - Groq (OpenAI-compatible; config/ai.php). Kosongkan LLM_PROVIDER untuk menonaktifkan.
# Uji setelah deploy:  php artisan sigap:llm-uji  (opsi --stt, --vision, --ukur)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
# RAHASIA.
LLM_API_KEY=GANTI_DENGAN_KUNCI_API_GROQ
LLM_MODEL=openai/gpt-oss-120b
# Kosong = foto chat tidak didukung (isi hanya setelah `sigap:llm-uji --vision` lolos).
LLM_VISION_MODEL=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=20
AI_MAX_ITERATIONS=4
AI_RATE_PER_MINUTE=20
AI_RATE_PER_HOUR=30
# Pelindung token global di bawah kuota gratis Groq (8K/menit, 200K/hari).
AI_TOKEN_PER_MINUTE=7000
AI_TOKEN_PER_DAY=190000
AI_TOOL_SELECTION=auto
AI_DRAFT_TTL_MINUTES=30

# Speech-to-text (pesan suara) - Groq Whisper. STT_API_KEY diisi eksplisit (tidak memakai LLM_API_KEY).
STT_DRIVER=http
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# RAHASIA.
STT_API_KEY=GANTI_DENGAN_KUNCI_API_GROQ
STT_MODEL=whisper-large-v3-turbo
STT_TIMEOUT=20

# ---------------------------------------------------------------------------
# Aturan bisnis (config/operasional.php, gudang.php, produksi.php, unggahan.php)
# ---------------------------------------------------------------------------
# Ambang (rupiah) pengeluaran non-menu yang wajib persetujuan investor. 0 = SEMUA pengeluaran non-menu wajib
# disetujui (bawaan config). KEPUTUSAN BISNIS: diisi pemilik bisnis saat go-live, mis. 1000000.
SIGAP_AMBANG_PERSETUJUAN_PENGELUARAN=0
SIGAP_TOLAK_MELEBIHI_ANGGARAN=false
SIGAP_UPLOAD_RATE_PER_MINUTE=20
SIGAP_TRIP_SPEED_KMH=30
SIGAP_TRIP_BUFFER_MINUTES=5
SIGAP_DISTRIBUSI_TOLERANSI_MENIT=15
SIGAP_BUKTI_BELUM_MASUK_MENIT=60
GUDANG_CEK_STOK_JAM=06:00
GUDANG_KEDALUWARSA_HARI=3
MUTU_SUHU_MINIMUM_C=60

# ---------------------------------------------------------------------------
# Cadangan (scripts/backup.sh, restore.sh, restore-test.sh). Bukan rahasia; kredensial tujuan TIDAK di sini.
# ---------------------------------------------------------------------------
# Tujuan rclone "<remote>:<bucket>/<prefiks>", mis. s3sigap:nama-bucket/sigap. Remote didefinisikan di
# BACKUP_RCLONE_CONFIG (contoh S3 ap-southeast-1 dengan instance profile:
#   [s3sigap] type = s3, provider = AWS, env_auth = true, region = ap-southeast-1, no_check_bucket = true).
# Kosong = hanya salinan lokal (staging awal; go-live WAJIB terisi).
BACKUP_REMOTE=
BACKUP_RCLONE_CONFIG=/etc/sigap/rclone.conf
BACKUP_RCLONE_IMAGE=rclone/rclone:1.69
# Flag rclone untuk hak IAM hanya-tulis (tanpa HEAD/GET objek, tanpa cek/buat bucket).
BACKUP_RCLONE_FLAGS="--no-check-dest --s3-no-head --s3-no-check-bucket"
# Kunci PUBLIK age (age1...). Kunci privat TIDAK PERNAH di server (simpan luring oleh pemilik).
BACKUP_AGE_RECIPIENT=
# Direktori lokal (mode 700) untuk dump pra-deploy dan salinan terenkripsi terakhir.
BACKUP_LOCAL_DIR=/var/backups/sigap
# Retensi salinan terenkripsi lokal (hari) dan jumlah dump pra-deploy polos (pemulihan cepat) yang disimpan.
BACKUP_RETENTION_DAYS=7
BACKUP_PREDEPLOY_KEEP=3
# Umur maksimum dump pengaman polos (pre-deploy/pre-restore) di disk server (hari).
BACKUP_PREDEPLOY_MAX_DAYS=14
# Hapus objek remote lebih tua dari BACKUP_REMOTE_RETENTION_DAYS lewat rclone (butuh hak hapus).
# Disarankan false + lifecycle rule bucket (server cukup hak PutObject/ListBucket).
BACKUP_REMOTE_PRUNE=false
BACKUP_REMOTE_RETENTION_DAYS=30
# Ikut cadangkan storage/app (unggahan foto/nota) setiap backup harian: true|false.
BACKUP_INCLUDE_FILES=true
# Opsional: URL ping pemantau (mis. healthchecks.io); kosong = nonaktif. Dipanggil tanpa data.
BACKUP_PING_URL=
