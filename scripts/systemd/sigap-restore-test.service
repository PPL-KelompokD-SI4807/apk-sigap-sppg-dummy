# SiGAP SPPG - uji pemulihan mingguan ke DB sementara sigap_restore_test (tanpa menulis ke DB produksi).
# Opsional; aktifkan: sudo systemctl enable --now sigap-restore-test.timer. Log: journalctl -u sigap-restore-test
[Unit]
Description=SiGAP SPPG - uji pemulihan mingguan
After=docker.service
Requires=docker.service
# Percobaan ulang terbatas: maks 3 kali dalam 3 jam.
StartLimitIntervalSec=3h
StartLimitBurst=3

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/sigap/app
ExecStart=/bin/bash /opt/sigap/app/scripts/restore-test.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
Environment=NO_COLOR=1
# Tunggu kunci operasi (deploy/backup/restore lain) hingga 30 menit, bukan langsung gagal.
Environment=SIGAP_LOCK_WAIT=1800
Restart=on-failure
RestartSec=10min
